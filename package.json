    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "start": "concurrently -n laravel,vite -c green,blue \"php artisan serve\" \"npm run dev\"",
        "lint": "eslint resources/js/",
